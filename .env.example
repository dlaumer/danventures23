POSTGRES_DB=danventures
POSTGRES_USER=dan
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://dan:replace-with-a-long-random-password@db:5432/danventures
OPENROUTESERVICE_API_KEY=replace-with-your-openrouteservice-api-key
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OPENROUTESERVICE_TIMEOUT_SECONDS=20

# Free subdomain, for example danventures-api.duckdns.org
API_DOMAIN=your-free-subdomain.example.org

# GitHub Pages frontend origin, for example https://yourname.github.io
CORS_ORIGINS=https://yourname.github.io,http://localhost:5173,http://127.0.0.1:5173

# Used by the frontend build, for example https://danventures-api.duckdns.org
VITE_API_BASE_URL=https://your-free-subdomain.example.org
